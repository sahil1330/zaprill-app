# Copy to .env.local. Names only — fill values locally. Do not commit secrets.

# Neon Postgres connection string. A pooler URL is fine; Drizzle Kit and the pg pool strip "-pooler".
DATABASE_URL=

# Better Auth signing secret. The library reads this name even though app code does not reference it.
BETTER_AUTH_SECRET=

# Canonical app origin. Auth cookies, HQ redirects, email links, checkout return URLs.
BETTER_AUTH_URL=
NEXT_PUBLIC_APP_URL=

# Google sign-in (not the GA4 Data API client below).
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# OpenAI. @ai-sdk/openai reads this for gpt-5-mini (parse, gaps, ATS, tailor, roast, summary, enhance, architect).
OPENAI_API_KEY=

# Resend transactional email and inbound webhook verification.
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=

# Cashfree. Server flag defaults to SANDBOX when unset. The public flag is separate and must match.
CASHFREE_CLIENT_ID=
CASHFREE_CLIENT_SECRET=
CASHFREE_ENVIRONMENT=
NEXT_PUBLIC_CASHFREE_ENVIRONMENT=

# Adzuna job search (India endpoint).
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# Browser Google Analytics 4. Root layout passes this to GoogleAnalytics.
NEXT_PUBLIC_GA4_MEASUREMENT_ID=

# HQ analytics via the GA4 Data API. Distinct from the OAuth sign-in client.
GA_PROPERTY_ID=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=

# Playwright. Optional. Defaults exist in e2e config; set these instead of relying on the committed demo password.
PLAYWRIGHT_BASE_URL=
DEMO_EMAIL=
DEMO_PASSWORD=

# Set by the platform or the framework. Leave unset locally.
# NODE_ENV
# CI
# VERCEL_ENV
# VERCEL_PROJECT_PRODUCTION_URL
